# Copy to .env to override any of these. Every value has a working default, so
# an empty .env is fine.

# --- ports on your machine -------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8090
CONVERTER_PORT=5001
DB_PORT=5432

# --- database --------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mockcreator
DB_TIMEZONE=UTC

# --- document conversion ---------------------------------------------------
# Which extraction engine to use.
# auto     : read the PDF's own text layer when it has one, OCR when it does not
# geometry : always read the text layer, and fail if there is none
# docling  : always use the layout model
#
# "auto" is right for almost everything. The text layer states exactly where each
# character sits, so reading it directly gets multi-column papers in the correct
# order; a layout model has to infer that order and interleaves the columns.
CONVERTER_ENGINE=auto

# auto  : measure each PDF's text layer and only OCR pages that need it
# force : OCR every page, for photocopies and poor scans
# off   : never OCR
CONVERTER_OCR_MODE=auto

# rapidocr is bundled and CPU-only. easyocr and tesseract are also installed.
CONVERTER_OCR_ENGINE=rapidocr

# accurate gives better tables (answer-key grids); fast is quicker
CONVERTER_TABLE_MODE=accurate

# How many documents convert at once. Each one can use a couple of gigabytes,
# so raise this only alongside CONVERTER_MEMORY_LIMIT.
CONVERTER_CONCURRENCY=2
CONVERTER_MEMORY_LIMIT=6G
CONVERTER_THREADS=4
CONVERTER_CONVERT_TIMEOUT=30m

# --- API -------------------------------------------------------------------
SERVER_ENV=production

# Background jobs running at once.
WORKER_CONCURRENCY=2

# Largest single upload, in bytes. 134217728 is 128 MiB. Raising this beyond
# 256 MiB also needs client_max_body_size changed in frontend/nginx.conf.
UPLOAD_MAX_BYTES=134217728

# Questions read out of a real question paper were already vetted by whoever set
# that paper, so they are approved on arrival. This applies only to questions
# that pass every quality check: anything with an open issue waits for a person
# regardless. Set to false to review every extracted question by hand.
REVIEW_AUTO_APPROVE_EXTRACTED=true

# Conversions scoring below this are still ingested, but everything they produce
# goes to review instead of being usable. Raise it to be stricter about which
# documents are trusted.
CONVERTER_MIN_CONFIDENCE=0.75

# --- model-backed quality control (optional) -------------------------------
# The deterministic checks run always and are what gate delivery. A model adds
# the judgements rules cannot make: whether a question is answerable, whether an
# explanation contradicts its answer, whether two rewordings are the same
# question, and a final read-through of each generated paper.
#
# With nothing set here, those checks report themselves as "not run". They are
# never counted as passes.
#
# Any OpenAI-compatible endpoint works. To run a model locally:
#   docker compose --profile llm up -d
#   docker compose exec ollama ollama pull qwen3:30b-a3b-instruct-2507-q4_K_M
# then uncomment:
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# OLLAMA_MEMORY_LIMIT=24G
#
# Smaller machines: qwen3:14b (9 GB, OLLAMA_MEMORY_LIMIT=12G) or
# qwen3:4b-instruct (2.5 GB, 6G). A weaker model finds fewer problems; it cannot
# introduce wrong content, because every fragment a model returns is checked
# against the source text before it is believed.
#
# Or point it at a hosted provider:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# How many model calls run at once. Local servers fall over under more.
LLM_MAX_CONCURRENCY=4
# Cap on how much source text goes into one call, so a long passage cannot
# overflow the context window.
LLM_MAX_INPUT_CHARS=24000
# Which reviews the model may perform.
LLM_AUDIT_QUESTIONS=true
LLM_AUDIT_PAPERS=true
LLM_REPAIR_BOUNDARIES=true
LLM_JUDGE_DUPLICATES=true

# Browser origins allowed to call the API directly. Only needed when running the
# frontend outside Docker with `npm run dev`.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- access control --------------------------------------------------------
# The API is unauthenticated by default, which is only safe on a private
# network. Set a key here to require X-API-Key on every request, and set the
# same value as VITE_API_KEY when building the frontend.
# API_KEY=change-me
