# Only needed to run the API outside Docker (`go run ./cmd/server`).
# Inside Docker every value is supplied by docker-compose.yml.

SERVER_PORT=8080
SERVER_ENV=development

# --- database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mockcreator
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# --- document conversion service -------------------------------------------
# Run it with: cd services/converter && uvicorn app.main:app --port 5001
CONVERTER_URL=http://localhost:5001
CONVERTER_API_KEY=
CONVERTER_REQUEST_TIMEOUT=2m
CONVERTER_CONVERT_TIMEOUT=30m
CONVERTER_POLL_INTERVAL=2s
CONVERTER_OCR_MODE=auto
CONVERTER_OCR_ENGINE=rapidocr
CONVERTER_TABLE_MODE=accurate

# --- background workers ----------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=2s
WORKER_MAX_ATTEMPTS=2
# A job stuck in "processing" longer than this is treated as orphaned by a
# restart and put back on the queue.
WORKER_STALE_AFTER=45m

# --- uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=134217728
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,doc,pptx,xlsx,xls,html,htm,md,txt,csv,rtf,odt,epub,png,jpg,jpeg,tiff,tif,bmp,webp

# --- review ----------------------------------------------------------------
REVIEW_SCORE_THRESHOLD=7
REVIEW_AUTO_APPROVE_EXTRACTED=true

# --- access control --------------------------------------------------------
# Unset means no authentication, which is only safe on a private network.
API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- optional model-backed generation and review ---------------------------
# Not wired up yet. The engine works fully without these.
GEN_MODEL_PROVIDER=
GEN_MODEL_NAME=
GEN_MODEL_API_KEY=
GEN_MODEL_BASE_URL=
REVIEW_MODEL_NAME=
